{
  "version": "v1",
  "hooks": [
    {
      "name": "Security Check on Write",
      "trigger": "PreToolUse",
      "description": "書き込みツールの入力を検査し、認証情報の平文書き込みをブロックする",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "node .kiro/hooks/scripts/security-check-on-write.cjs"
      },
      "timeout": 30,
      "enabled": true
    }
  ]
}
