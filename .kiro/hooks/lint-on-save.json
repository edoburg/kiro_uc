{
  "version": "v1",
  "hooks": [
    {
      "name": "Lint on Save (TypeScript/Python)",
      "trigger": "PostFileSave",
      "description": "TypeScript、TSX、Pythonファイルの保存後にプロジェクトの静的検査を実行する",
      "matcher": "\\.(ts|tsx|py)$",
      "action": {
        "type": "command",
        "command": "node .kiro/hooks/scripts/lint-on-save.cjs"
      },
      "timeout": 120,
      "enabled": true
    }
  ]
}
