{
  "version": "v1",
  "hooks": [
    {
      "name": "Run Tests After Task",
      "trigger": "PostTaskExec",
      "description": "Specタスク完了後にVitestとpytestをプロジェクトの環境で実行する",
      "action": {
        "type": "command",
        "command": "node .kiro/hooks/scripts/run-tests-after-task.cjs"
      },
      "timeout": 300,
      "enabled": true
    }
  ]
}
